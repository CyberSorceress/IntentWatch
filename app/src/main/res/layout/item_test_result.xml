<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_test_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Test Scenario Name"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_test_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SINGLE MATCH"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_info"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_test_uri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="intentwatch-test://vulnerable?param=val"
            android:textColor="@color/text_code"
            android:textSize="12sp"
            android:background="@color/bg_input"
            android:padding="8dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tv_test_outcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Outcome description"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tv_test_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Executed: 2026-10-09 12:00:00"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:layout_marginTop="6dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
