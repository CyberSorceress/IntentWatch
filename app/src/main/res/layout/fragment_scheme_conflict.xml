<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Header & Summary Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_card"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conflicts_title"
                android:textColor="@color/accent_cyan"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_conflicts_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detects overlapping URI schemes, hijacking vectors, and unverified App Links."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <!-- Metrics Pills Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@color/bg_input"
                    android:padding="8dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:id="@+id/tv_stat_collisions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/severity_critical"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Collisions"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@color/bg_input"
                    android:padding="8dp"
                    android:layout_marginHorizontal="2dp">

                    <TextView
                        android:id="@+id/tv_stat_overlapping"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/severity_high"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Overlaps"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@color/bg_input"
                    android:padding="8dp"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:id="@+id/tv_stat_exported_unprotected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/severity_moderate"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exported"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- RecyclerView for Conflicts -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_conflicts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="6dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_conflicts_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="No scheme conflicts detected.\nRun a full scan from the Dashboard or Scanner to analyze."
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

</LinearLayout>
