<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Header & Search Bar Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_card"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scanner_title"
                        android:textColor="@color/accent_cyan"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_scanner_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 handlers in inventory"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_refresh_scan"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_refresh"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Refresh Scan" />

                <ImageButton
                    android:id="@+id/btn_scanner_import_apk"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_upload"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Import APK" />
            </LinearLayout>

            <!-- Search Field -->
            <EditText
                android:id="@+id/et_search_deeplinks"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="@string/search_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp"
                android:background="@color/bg_input"
                android:paddingHorizontal="12dp"
                android:drawableStart="@drawable/ic_scanner"
                android:drawablePadding="8dp"
                android:layout_marginTop="12dp" />

            <!-- Filter Buttons Horizontal Scroll -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_filter_all"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="All"
                        android:textColor="@color/accent_cyan"
                        app:strokeColor="@color/accent_cyan"
                        android:textSize="11sp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_filter_custom"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Custom Schemes"
                        android:textColor="@color/text_secondary"
                        app:strokeColor="@color/border_subtle"
                        android:textSize="11sp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_filter_http"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="HTTP / HTTPS"
                        android:textColor="@color/text_secondary"
                        app:strokeColor="@color/border_subtle"
                        android:textSize="11sp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_filter_exported"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Exported"
                        android:textColor="@color/text_secondary"
                        app:strokeColor="@color/border_subtle"
                        android:textSize="11sp"
                        android:paddingHorizontal="10dp" />
                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <ProgressBar
        android:id="@+id/progress_scanner"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- RecyclerView for Discovered Links -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_deeplinks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="6dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_scanner_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="No deep-link handlers found.\nTap refresh icon to scan installed applications or import an APK."
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

</LinearLayout>
