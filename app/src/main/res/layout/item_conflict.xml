<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_conflict_scheme"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="custom-scheme://"
                android:textColor="@color/accent_cyan"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_conflict_severity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH RISK"
                android:textColor="@color/severity_high"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_high"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_conflict_handlers_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 Handlers Competing (Routing Ambiguity)"
            android:textColor="@color/severity_moderate"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/tv_conflict_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Competing: App 1, App 2"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tv_conflict_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description of scheme overlap and hijacking vector."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tv_conflict_remediation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remediation: Migrate to verified Android App Links."
            android:textColor="@color/accent_teal"
            android:textSize="11sp"
            android:background="@color/bg_input"
            android:padding="8dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
