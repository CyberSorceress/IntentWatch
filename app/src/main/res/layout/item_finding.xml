<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_finding_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FINDING-001"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_finding_severity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH"
                android:textColor="@color/severity_high"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_high"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tv_finding_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIRMED"
                android:textColor="@color/severity_low"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_low"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_finding_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vulnerability Title"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tv_finding_component"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Target: com.example.app.Activity"
            android:textColor="@color/text_code"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_finding_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detailed explanation of the flaw."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tv_finding_evidence"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Source: Manifest Inspection"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_finding_action_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MARK RESOLVED"
                android:textColor="@color/accent_teal"
                android:textSize="11sp"
                android:textStyle="bold"
                android:padding="4dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
